generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MERCHANT
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BadgeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnalyticsEventType {
  VIEW
  WHATSAPP_CLICK
  PRODUCT_VIEW
}

enum PostType {
  ANNOUNCEMENT
  EVENT
  LOST_FOUND
  VOLUNTEER
  DISCUSSION
}

enum LostFoundItemType {
  LOST
  FOUND
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  role          Role            @default(USER)
  profile       Json?
  createdAt     DateTime        @default(now())
  storefront    Storefront?
  orders        Order[]
  notifications Notification[]
  advisorUsage  AIAdvisorUsage[]
  posts         Post[]
  notes         Note[]
  internships   Internship[]    @relation("InternshipPostedBy")
  jobs          Job[]           @relation("JobPostedBy")
  postVotes     PostVote[]
  eventRsvps    EventRsvp[]
  groupMembers  CollegeGroupMember[]
  groupAnnouncements GroupAnnouncement[]
}

model Storefront {
  id          String           @id @default(uuid())
  userId      String           @unique
  slug        String           @unique
  name        String
  description String?
  sector      String
  published   Boolean          @default(false)
  featured    Boolean          @default(false)
  verified    Boolean          @default(false)
  coverUrl    String?
  logoUrl     String?
  whatsapp    String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  orders      Order[]
  leads       Lead[]
  reviews     Review[]
  badge       Badge?
  analytics   AnalyticsEvent[]
}

model Product {
  id           String   @id @default(uuid())
  storefrontId String
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  stock        Int?
  hidden       Boolean  @default(false)
  images       Json
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  orderItems   Order[]

  @@index([storefrontId, order])
}

model Order {
  id            String      @id @default(uuid())
  storefrontId   String
  customerName   String
  customerPhone  String
  customerEmail  String?
  items          Json
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  storefront     Storefront  @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
}

model Lead {
  id           String    @id @default(uuid())
  storefrontId String
  name         String?
  phone        String?
  message      String?
  createdAt    DateTime  @default(now())
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
}

model Review {
  id           String    @id @default(uuid())
  storefrontId String
  authorName   String
  rating       Int
  body         String?
  approved     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId, approved])
}

model Badge {
  id          String      @id @default(uuid())
  storefrontId String     @unique
  status      BadgeStatus @default(PENDING)
  requestedAt DateTime    @default(now())
  reviewedAt  DateTime?
  code        String      @unique
  storefront  Storefront  @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id           String             @id @default(uuid())
  storefrontId String
  type         AnalyticsEventType
  metadata     Json?
  createdAt    DateTime           @default(now())
  storefront   Storefront         @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model AIAdvisorUsage {
  id        String   @id @default(uuid())
  userId    String
  month     String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model Post {
  id          String   @id @default(uuid())
  authorId    String
  type        PostType
  title       String
  body        String
  images      String[]
  district    String
  tehsil      String?
  pinned      Boolean  @default(false)
  resolved    Boolean  @default(false)
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event       Event?
  lostFound   LostFoundItem?
  volunteer   VolunteerOpportunity?
  votes       PostVote[]

  @@index([district, createdAt])
  @@index([type, createdAt])
}

model Event {
  id           String   @id @default(uuid())
  postId       String   @unique
  date         DateTime
  location     String
  coordinates  Json?
  rsvpCount    Int      @default(0)
  maxAttendees Int?
  ticketPrice  Decimal? @db.Decimal(10, 2)
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  rsvps        EventRsvp[]
}

model LostFoundItem {
  id                String           @id @default(uuid())
  postId            String           @unique
  itemType          LostFoundItemType
  category          String
  lastSeenLocation  String
  contactPhone      String
  resolved          Boolean          @default(false)
  post              Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model VolunteerOpportunity {
  id           String   @id @default(uuid())
  postId       String   @unique
  organization String
  skills       String[]
  startDate    DateTime
  endDate      DateTime?
  slots        Int
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Note {
  id          String   @id @default(uuid())
  authorId    String
  subject     String
  class       String
  university  String
  fileUrl     String
  downloads   Int      @default(0)
  verified    Boolean  @default(false)
  ocrText     String?
  createdAt   DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([subject, university])
}

model Internship {
  id          String   @id @default(uuid())
  companyName String
  role        String
  location    String
  stipend     String?
  deadline    DateTime
  applyUrl    String
  postedBy    String
  createdAt   DateTime @default(now())
  poster      User     @relation("InternshipPostedBy", fields: [postedBy], references: [id], onDelete: Cascade)
}

model Job {
  id          String         @id @default(uuid())
  companyName String
  role        String
  location    String
  salary      String?
  type        EmploymentType
  deadline    DateTime
  applyUrl    String
  preferLocal Boolean        @default(false)
  postedBy    String
  createdAt   DateTime       @default(now())
  poster      User           @relation("JobPostedBy", fields: [postedBy], references: [id], onDelete: Cascade)
}

model PostVote {
  postId     String
  userId     String
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model EventRsvp {
  eventId     String
  userId      String
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model CollegeGroup {
  id            String               @id @default(uuid())
  slug          String               @unique
  name          String
  members       CollegeGroupMember[]
  announcements GroupAnnouncement[]
  createdAt     DateTime             @default(now())
}

model CollegeGroupMember {
  groupId    String
  userId     String
  createdAt  DateTime     @default(now())
  group      CollegeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model GroupAnnouncement {
  id         String       @id @default(uuid())
  groupId    String
  authorId   String
  title      String
  body       String
  pinned     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  group      CollegeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  resourceType String
  resourceId  String
  ipAddress   String
  userAgent   String
  payloadHash String
  timestamp   DateTime @default(now())
  success     Boolean
  errorCode   String?

  @@index([userId, timestamp])
  @@index([action, timestamp])
}
