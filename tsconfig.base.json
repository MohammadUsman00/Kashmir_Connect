{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@kashmir/db": ["packages/database/src/index.ts"],
      "@kashmir/db/*": ["packages/database/src/*"],
      "@kashmir/types": ["packages/types/src/index.ts"],
      "@kashmir/types/*": ["packages/types/src/*"],
      "@kashmir/ui": ["packages/ui/src/index.ts"],
      "@kashmir/ui/*": ["packages/ui/src/*"]
    }
  }
}
